# ============================================================
# Open Source Contributor Assistant — Backend Configuration
# ============================================================
# Copy this file to .env and fill in any values as needed.
# Do NOT commit .env to source control.

# --- Repository Processing Limits ---
MAX_REPO_SIZE_MB=100
MAX_FILES=500
MAX_COMMITS=100

# --- Chunking Configuration ---
CHUNK_SIZE=100
CHUNK_OVERLAP=20

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# Person C — RAG / LLM Integration (not implemented here)
# ============================================================
# LLM_API_KEY=
# VECTOR_DB_PATH=./data/vectordb
